# এই ফাইলটা শুধু নমুনা। আসল মান .env ফাইলে বসান — .env কখনো GitHub-এ তুলবেন না (.gitignore আটকায়)।
# পাসওয়ার্ড (লম্বা, এলোমেলো কিছু রাখুন)
APP_TOKEN=

# AI ১ (Google AI Studio থেকে): মূল AI
GEMINI_API_KEY=

# AI ২ (২য় provider, OpenAI-ধাঁচের হলে): fallback + দ্বিতীয় মত
AI2_API_KEY=
AI2_BASE_URL=
AI2_MODEL=

# Tavily (review/scam খোঁজা)
TAVILY_API_KEY=

# Telegram user session (my.telegram.org → scripts/telegram_login.py চালিয়ে পাবেন)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=

# Telegram bot (@BotFather থেকে)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_PAIR_CODE=

# Flipkart affiliate (পরীক্ষামূলক, optional)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# https reverse proxy বসালে 1, নইলে 0
COOKIE_SECURE=0
